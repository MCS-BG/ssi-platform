# Copy to secrets.auto.tfvars (git-ignored, loaded automatically). Generate
# fresh values (openssl rand ...); never commit the real file or paste values
# into chat. Remove the Langfuse/Grafana entries if enable_observability = false.

app_secrets = {
  pgvector_password        = "<openssl rand -base64 24>"
  webui_secret_key         = "<openssl rand -hex 32>"
  ssi_gateway_token        = "<openssl rand -hex 32>"
  grafana_admin_password   = "<openssl rand -base64 24>"
  langfuse_init_public_key = "pk-lf-<random>"
  langfuse_init_secret_key = "sk-lf-<random>"
  langfuse_admin_email     = "<admin email>"
  langfuse_admin_password  = "<openssl rand -base64 24>"
  # Gated Hugging Face models (Prompt Guard download, vLLM weights):
  hf_token                 = "<hugging face read token: Prompt Guard is gated>"
}
