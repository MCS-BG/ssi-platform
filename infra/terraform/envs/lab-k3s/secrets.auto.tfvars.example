# Copy to secrets.auto.tfvars (git-ignored, loaded automatically) ONLY when
# rebuilding a cluster that does not have the Secrets yet. On the existing lab
# leave create_secrets = false: the Secrets already exist and are referenced by
# name. Never commit the real file and never paste these values into chat.

create_secrets = true

pgvector_password        = "<openssl rand -base64 24>"
webui_secret_key         = "<openssl rand -hex 32>"
ssi_gateway_token        = "<openssl rand -hex 32>"
grafana_admin_password   = "<openssl rand -base64 24>"
langfuse_init_public_key = "pk-lf-<random>"
langfuse_init_secret_key = "sk-lf-<random>"
langfuse_admin_email     = "<admin email>"
langfuse_admin_password  = "<openssl rand -base64 24>"
hf_token                 = "<hugging face read token: Prompt Guard is gated>"

# Tailscale operator OAuth client (home lab only, first install only).
tailscale_oauth_client_id     = "<client id>"
tailscale_oauth_client_secret = "<client secret>"
